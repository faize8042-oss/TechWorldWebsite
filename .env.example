
POSTGRES_DB=techworld_db
POSTGRES_USER=techworld_user
POSTGRES_PASSWORD=change-me

SECRET_KEY=generate-a-new-secret-key
DEBUG=True
DEPLOYMENT_MODE=development
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

DATABASE_URL=postgres://techworld_user:change-me@127.0.0.1:5432/techworld_db

APP_URL=http://127.0.0.1:8000

# SEO remains disabled until the real public HTTPS origin is configured.
# Set SEO_SITE_URL to that origin and SEO_INDEXING_ENABLED=True only after deployment.
SEO_SITE_URL=
# Planned origin after domain purchase and verified HTTPS: https://techbullionhub.net
SEO_INDEXING_ENABLED=False

CONTACT_EMAIL=your-email@example.com
DEFAULT_FROM_EMAIL=Tech World <your-email@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

ANALYTICS_HMAC_SECRET=generate-a-separate-random-secret
ANALYTICS_RETENTION_DAYS=90


ENABLE_HTTPS=False
# Keep disabled until HTTPS has been verified.
HSTS_SECONDS=0
# Set DEPLOYMENT_MODE=production only for deployment validation/runtime.
# Production requires confirmed ALLOWED_HOSTS, HTTPS origins, PostgreSQL, SMTP,
# a strong SECRET_KEY, and ENABLE_HTTPS=True after the proxy is verified.
