# Proposed template. Replace both server_name values and certificate paths only
# after domain ownership, DNS, and certificate issuance are verified.
upstream django_app {
    server web:8000;
    keepalive 16;
}

# Reject unknown HTTP hosts instead of reflecting them into redirects.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

# Bootstrap with an HTTP-only configuration while verifying reachability and
# obtaining a certificate. Enable this redirect only after TLS is operational.
server {
    listen 80;
    server_name codeventralabs.com www.codeventralabs.com;

    client_max_body_size 6m;

    location / {
        return 301 https://codeventralabs.com$request_uri;
    }
}

# Reject unrecognized TLS names and hosts; this server has no application route.
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    return 444;
}

server {
    listen 443 ssl;
    http2 on;
    server_name codeventralabs.com www.codeventralabs.com;

    ssl_certificate     /etc/letsencrypt/live/REPLACE_WITH_CONFIRMED_HOST/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/REPLACE_WITH_CONFIRMED_HOST/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 6m;
    server_tokens off;

    # Only the explicitly public media volume is mounted here. Private contact
    # attachments live in a separate volume and are never served by Nginx.
    location /media/ {
        alias /srv/media/;
        autoindex off;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # WhiteNoise serves /static/ from the immutable application image.
    location / {
        proxy_pass http://django_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 60s;
    }

    location ~ (^|/)\. { deny all; }
    location ~* (\.env|\.git|private_uploads) { deny all; }
}
